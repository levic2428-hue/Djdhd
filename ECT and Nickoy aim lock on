
-- ECT AND NICKOY | MOBILE LOCK-ON
-- Closest Player + Auto Switch
-- Place in StarterPlayer > StarterPlayerScripts
-- For your own Roblox Studio experience

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local lockedTarget = nil
local lockEnabled = false
local switchDelay = 0
local SWITCH_COOLDOWN = 0.5
local BIND_NAME = "ECTLockOnFollow"

local gui
local button
local camera = workspace.CurrentCamera

-- Remove an older copy of the menu
local playerGui = player:WaitForChild("PlayerGui")
local oldGui = playerGui:FindFirstChild("ECTLockOn")
if oldGui then
    oldGui:Destroy()
end

-- Create mobile menu
gui = Instance.new("ScreenGui")
gui.Name = "ECTLockOn"
gui.ResetOnSpawn = false
gui.Parent = playerGui

button = Instance.new("TextButton")
button.Name = "LockButton"
button.Size = UDim2.fromOffset(160, 48)
button.Position = UDim2.new(1, -175, 0.65, 0)
button.BackgroundColor3 = Color3.fromRGB(125, 50, 220)
button.TextColor3 = Color3.new(1, 1, 1)
button.Text = "ECT: LOCK ON"
button.TextScaled = true
button.Font = Enum.Font.GothamBold
button.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = button

-- Find closest living player to your character
local function getNearestTarget(excludedTarget)
    local character = player.Character
    local myRoot = character
        and character:FindFirstChild("HumanoidRootPart")

    if not myRoot then
        return nil
    end

    local nearestTarget = nil
    local shortestDistance = math.huge

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other ~= excludedTarget then
            local otherCharacter = other.Character
            local otherRoot = otherCharacter
                and otherCharacter:FindFirstChild("HumanoidRootPart")
            local humanoid = otherCharacter
                and otherCharacter:FindFirstChildOfClass("Humanoid")

            if otherRoot and humanoid and humanoid.Health > 0 then
                local distance =
                    (otherRoot.Position - myRoot.Position).Magnitude

                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestTarget = other
                end
            end
        end
    end

    return nearestTarget
end

local function unlock()
    lockEnabled = false
    lockedTarget = nil
    switchDelay = 0

    button.Text = "ECT: LOCK ON"
    button.BackgroundColor3 = Color3.fromRGB(125, 50, 220)
end

local function lockOn()
    camera = workspace.CurrentCamera
    lockedTarget = getNearestTarget()

    if not lockedTarget then
        button.Text = "NO TARGET"

        task.delay(1, function()
            if not lockEnabled and button.Parent then
                button.Text = "ECT: LOCK ON"
            end
        end)

        return
    end

    lockEnabled = true
    button.Text = "ECT: UNLOCK"
    button.BackgroundColor3 = Color3.fromRGB(70, 180, 110)
end

-- Mobile toggle
button.Activated:Connect(function()
    if lockEnabled then
        unlock()
    else
        lockOn()
    end
end)

-- Camera follow + closest-target switching
RunService:UnbindFromRenderStep(BIND_NAME)

RunService:BindToRenderStep(
    BIND_NAME,
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)
        if not lockEnabled then
            return
        end

        camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local targetCharacter = lockedTarget
            and lockedTarget.Character

        local targetRoot = targetCharacter
            and targetCharacter:FindFirstChild("HumanoidRootPart")

        local targetHumanoid = targetCharacter
            and targetCharacter:FindFirstChildOfClass("Humanoid")

        local targetInvalid =
            not lockedTarget
            or not lockedTarget:IsDescendantOf(Players)
            or not targetRoot
            or not targetHumanoid
            or targetHumanoid.Health <= 0

        if targetInvalid then
            switchDelay = switchDelay + deltaTime

            if switchDelay >= SWITCH_COOLDOWN then
                switchDelay = 0

                -- Prefer a different player after a target is lost
                lockedTarget = getNearestTarget(lockedTarget)

                -- If nobody else exists, retry any living player
                if not lockedTarget then
                    lockedTarget = getNearestTarget()
                end

                if not lockedTarget then
                    unlock()
                    return
                end

                targetCharacter = lockedTarget.Character
                targetRoot = targetCharacter
                    and targetCharacter:FindFirstChild("HumanoidRootPart")
                targetHumanoid = targetCharacter
                    and targetCharacter:FindFirstChildOfClass("Humanoid")
            end

            if not targetRoot
                or not targetHumanoid
                or targetHumanoid.Health <= 0 then
                return
            end
        else
            switchDelay = 0
        end

        -- Smoothly turn the camera toward the selected target
        local aimPosition =
            targetRoot.Position + Vector3.new(0, 1.5, 0)

        local desired = CFrame.lookAt(
            camera.CFrame.Position,
            aimPosition
        )

        local alpha = 1 - math.exp(-8 * deltaTime)
        camera.CFrame = camera.CFrame:Lerp(desired, alpha)
    end
)

-- Reset when your character respawns
player.CharacterAdded:Connect(function()
    unlock()
end)

-- Clean up the camera binding when the script is destroyed
script.Destroying:Connect(function()
    RunService:UnbindFromRenderStep(BIND_NAME)
end)
